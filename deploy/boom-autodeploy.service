[Unit]
Description=Boom CI-gated automatic update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Boom
Environment=GIT_TERMINAL_PROMPT=0
UMask=0077
ExecStart=/usr/bin/python3 /home/ubuntu/.local/lib/boom-deploy/auto_update.py
TimeoutStartSec=12min
StandardOutput=journal
StandardError=journal
