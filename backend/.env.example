[TEMPLATE]
APP_NAME=Boom AI Konkoor Mentor
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8443,https://your-project.pages.dev,https://your-custom-domain.com
DEMO_USER_ID=1

# Generate a unique value for production. The launcher creates one locally.
SECRET_KEY=replace-with-a-random-secret-key

# LLM providers: cerebras, groq, openai, omniroute, ollama, gemini, or mock
# Limits vary by provider, model and account. Check the provider's dashboard.
# Cerebras offers limited trial credits; Groq and Gemini have capped free plans.
LLM_PROVIDER=cerebras
LLM_API_KEY=
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL_NAME=gpt-oss-120b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600

# Separate LLM provider/key/model for MOCK GENERATION only (pool worker,
# admin restock, live booklet builds). Booklet generation makes many large
# LLM calls and can exhaust a shared key's per-minute limits, which
# rate-limits the chatbot/planning at the same time. Leave a value empty to
# fall back to the main provider/key (old behavior).
POOL_LLM_PROVIDER=
POOL_LLM_API_KEY=
POOL_LLM_MODEL_NAME=
# Optional ordered Gemini backup keys (comma-separated), used only when the
# primary pool provider is Gemini. Same-project keys share one quota.
# Daily-exhausted Gemini keys are skipped until Pacific midnight. Explicit
# multi-key fleets switch on minute limits and remember each key's cooldown.
POOL_GEMINI_API_KEYS=
POOL_GROQ_API_KEYS=
LLM_GROQ_API_KEYS=
# Independent answer checks. Example: draft with Groq, verify with Gemini.
# Empty provider preserves legacy same-provider verification.
POOL_VERIFY_LLM_PROVIDER=
POOL_VERIFY_LLM_API_KEY=
POOL_VERIFY_LLM_MODEL_NAME=
POOL_VERIFY_GEMINI_API_KEYS=
POOL_VERIFY_MAX_TOKENS=2400
POOL_VERIFY_REASONING_EFFORT=low
# Small paced drafting batches leave capacity for interactive Groq calls.
# These are pool-only limits; 0 disables each workload limit.
POOL_GENERATION_BATCH_SIZE=4
POOL_GENERATION_MAX_TOKENS=2400
POOL_GENERATION_CONTEXT_CHARS=1800
POOL_GENERATION_REQUESTS_PER_MINUTE=1
# Explicit alternative providers, with their own configured credentials/models.
POOL_LLM_FALLBACK_PROVIDERS=
# Optional ignored file for terminal quota reset times across server restarts.
POOL_QUOTA_STATE_PATH=data/provider_quota.json
# Saved admin selections resume after restarts; count=0 has no stock ceiling.
POOL_RUN_STATE_FILE=data/pool-run.json
# Serve verified bank stock immediately; report empty stock rather than wait on AI.
POOL_ALLOW_LIVE_GENERATION=false

# Vision provider (independent of LLM_PROVIDER): gemini, groq, ollama, or mock
# Get a free Gemini key at https://aistudio.google.com/apikey
# GEMINI_PROXY routes Gemini traffic through a local proxy/VPN client
# (e.g. http://127.0.0.1:10809) where the API is geo-blocked; leave empty
# where Gemini is directly reachable (e.g. the production VM).
VISION_LLM_PROVIDER=gemini
VISION_LLM_MODEL_NAME=gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_PROXY=

# Cerebras Inference (https://cloud.cerebras.ai) - OpenAI-compatible,
# Check current trial credits, expiry, account limits and billing before use.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL_NAME=gpt-oss-120b

# Hosted text embeddings. Rebuild old vectors before switching providers.
# Uses EMBEDDING_API_KEY if provided, otherwise GEMINI_API_KEY above.
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_GEMINI_API_KEYS=
EMBEDDING_MODEL_NAME=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=24
EMBEDDING_REQUESTS_PER_MINUTE=10
EMBEDDING_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_PROXY=
# Legacy Ollama/OpenAI-compatible endpoint (unused by Gemini).
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DEVICE=cpu

# Storage and retrieval
UPLOAD_DIR=data/uploads
CHROMA_DIR=data/chroma_db
CHROMA_COLLECTION=documents
CHROMA_QA_COLLECTION=question_bank
# Gemini automatically appends model/dimension/retrieval-version suffixes
# to these base names. Preserve old collections for rollback.
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4

# Page-image RAG
PDF_PROCESSING_MODE=image
IMAGES_DIR=data/page_images
IMAGE_DPI=200
IMAGE_BATCH_SIZE=30
RAW_DIR=data/raw
RAW_INGEST_DPI=120
IMAGE_TOP_K=3
IMAGE_RELEVANCE_THRESHOLD=0.24
CHROMA_IMAGE_COLLECTION=document_images
IMAGE_EMBEDDING_BACKEND=clip
CLIP_IMAGE_MODEL_NAME=clip-ViT-B-32
CLIP_TEXT_MODEL_NAME=clip-ViT-B-32-multilingual-v1
COLPALI_MODEL_NAME=vidore/colqwen2.5-v0.2

# Bulk OCR corpus of the scanned books (via Gemini vision).
# Gives the planner knowledge of what each book contains; the vision path
# still reads the real page image for questions/answers/explanations.
# Run `python -m app.rag.ocr_corpus` (re-run daily until the library is done;
# it resumes where it stopped and respects GEMINI_OCR_DAILY_CAP).
OCR_DIR=data/ocr
OCR_DPI=120
OCR_PAGES_PER_REQUEST=4
OCR_SLEEP_SECONDS=5.0
GEMINI_OCR_DAILY_CAP=200

# ====== Security & AI usage limits (all adjustable) ==================
# Per-user daily AI quotas. 0 or negative = unlimited for that feature.
AI_DAILY_CHAT=50
AI_DAILY_STUDY_PLAN=10
AI_DAILY_WEEKLY_PLAN=20
AI_DAILY_TODAY_TESTS=30
AI_DAILY_MOCK_GENERATE=10
# Max upload size per file (MB)
MAX_UPLOAD_MB=20
# REQUIRED in production: random secret for JWT signing + code hashing.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=...

# SMS signup verification - SMS.ir (Melipayamak) panel.
# Create a verification template containing the #OTP# parameter, then
# fill in its numeric template id (panel shows it after approval).
SMS_API_KEY=
SMS_VERIFY_TEMPLATE_ID=
SMS_VERIFY_PARAMETER_NAME=OTP
# DEV ONLY: true = return the code in the API response instead of sending SMS.
SMS_DEBUG_ECHO=false
# false = SMS.ir calls ignore env-var/Windows-registry proxies (a closed VPN
# client like v2rayN otherwise hijacks them -> «سرویس پیامک در دسترس نیست»).
# Set true only if your network can only reach api.sms.ir through a proxy.
SMS_TRUST_ENV=false
# Optional explicit proxy for api.sms.ir when the direct route stalls
# (ISP-level TLS interference on domestic HTTPS). Example:
# SMS_PROXY=http://127.0.0.1:10809   (v2rayN HTTP port; must be RUNNING)
# Empty = direct only. GEMINI_PROXY never affects SMS.
SMS_PROXY=
# NOTE: if signup skips the SMS code step entirely, DISABLE_AUTH=true is why.
# Shared passcode letting admin-allowlisted numbers sign up without SMS while
# the template is unapproved. CHOOSE YOUR OWN VALUE; empty = bypass disabled.
SIGNUP_BYPASS_CODE=
