APP_NAME=Boom AI Konkoor Mentor
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8443,https://your-project.pages.dev,https://your-custom-domain.com
DEMO_USER_ID=1

# Generate a unique value for production. The launcher creates one locally.
SECRET_KEY=replace-with-a-random-secret-key

# LLM providers: groq, openai, omniroute, ollama, or mock
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen3:14b
VISION_LLM_MODEL_NAME=qwen2.5vl:7b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600

# Local Ollama embeddings (run: ollama pull nomic-embed-text)
EMBEDDING_PROVIDER=ollama
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_DEVICE=cpu

# Storage and retrieval
UPLOAD_DIR=data/uploads
CHROMA_DIR=data/chroma_db
CHROMA_COLLECTION=documents
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4

# Page-image RAG
PDF_PROCESSING_MODE=image
IMAGES_DIR=data/page_images
IMAGE_DPI=200
IMAGE_BATCH_SIZE=30
RAW_DIR=data/raw
RAW_INGEST_DPI=120
IMAGE_TOP_K=3
IMAGE_RELEVANCE_THRESHOLD=0.24
CHROMA_IMAGE_COLLECTION=document_images
IMAGE_EMBEDDING_BACKEND=clip
CLIP_IMAGE_MODEL_NAME=clip-ViT-B-32
CLIP_TEXT_MODEL_NAME=clip-ViT-B-32-multilingual-v1
COLPALI_MODEL_NAME=vidore/colqwen2.5-v0.2
