[TEMPLATE]
APP_NAME=Boom AI Konkoor Mentor
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8443,https://your-project.pages.dev,https://your-custom-domain.com
DEMO_USER_ID=1

# Generate a unique value for production. The launcher creates one locally.
SECRET_KEY=replace-with-a-random-secret-key

# LLM providers: cerebras, groq, openai, omniroute, ollama, gemini, or mock
# Free-tier snapshot: Cerebras ~30RPM/~1M tokens-day (fastest, biggest
# budget), Groq ~30RPM/~200k tokens-day, Gemini ~10RPM/1500RPD + vision.
LLM_PROVIDER=cerebras
LLM_API_KEY=
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL_NAME=gpt-oss-120b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600

# Separate LLM provider/key/model for MOCK GENERATION only (pool worker,
# admin restock, live booklet builds). Booklet generation makes many large
# LLM calls and can exhaust a shared key's per-minute limits, which
# rate-limits the chatbot/planning at the same time. Leave a value empty to
# fall back to the main provider/key (old behavior).
POOL_LLM_PROVIDER=
POOL_LLM_API_KEY=
POOL_LLM_MODEL_NAME=

# Vision provider (independent of LLM_PROVIDER): gemini, groq, ollama, or mock
# Get a free Gemini key at https://aistudio.google.com/apikey
# GEMINI_PROXY routes Gemini traffic through a local proxy/VPN client
# (e.g. http://127.0.0.1:10809) where the API is geo-blocked; leave empty
# where Gemini is directly reachable (e.g. the production VM).
VISION_LLM_PROVIDER=gemini
VISION_LLM_MODEL_NAME=gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_PROXY=

# Cerebras Inference (https://cloud.cerebras.ai) - OpenAI-compatible,
# free tier ~30 RPM / ~1M tokens per day, >1000 tok/s.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL_NAME=gpt-oss-120b

# Local Ollama embeddings (run: ollama pull nomic-embed-text)
EMBEDDING_PROVIDER=ollama
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_DEVICE=cpu

# Storage and retrieval
UPLOAD_DIR=data/uploads
CHROMA_DIR=data/chroma_db
CHROMA_COLLECTION=documents
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4

# Page-image RAG
PDF_PROCESSING_MODE=image
IMAGES_DIR=data/page_images
IMAGE_DPI=200
IMAGE_BATCH_SIZE=30
RAW_DIR=data/raw
RAW_INGEST_DPI=120
IMAGE_TOP_K=3
IMAGE_RELEVANCE_THRESHOLD=0.24
CHROMA_IMAGE_COLLECTION=document_images
IMAGE_EMBEDDING_BACKEND=clip
CLIP_IMAGE_MODEL_NAME=clip-ViT-B-32
CLIP_TEXT_MODEL_NAME=clip-ViT-B-32-multilingual-v1
COLPALI_MODEL_NAME=vidore/colqwen2.5-v0.2

# Bulk OCR corpus of the scanned books (via Gemini vision).
# Gives the planner knowledge of what each book contains; the vision path
# still reads the real page image for questions/answers/explanations.
# Run `python -m app.rag.ocr_corpus` (re-run daily until the library is done;
# it resumes where it stopped and respects GEMINI_OCR_DAILY_CAP).
OCR_DIR=data/ocr
OCR_DPI=120
OCR_PAGES_PER_REQUEST=4
OCR_SLEEP_SECONDS=5.0
GEMINI_OCR_DAILY_CAP=200

# ====== Security & AI usage limits (all adjustable) ==================
# Per-user daily AI quotas. 0 or negative = unlimited for that feature.
AI_DAILY_CHAT=50
AI_DAILY_STUDY_PLAN=10
AI_DAILY_WEEKLY_PLAN=20
AI_DAILY_TODAY_TESTS=30
AI_DAILY_MOCK_GENERATE=10
# Max upload size per file (MB)
MAX_UPLOAD_MB=20
# REQUIRED in production: random secret for JWT signing + code hashing.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=...

# SMS signup verification - SMS.ir (Melipayamak) panel.
# Create a verification template containing the #OTP# parameter, then
# fill in its numeric template id (panel shows it after approval).
SMS_API_KEY=
SMS_VERIFY_TEMPLATE_ID=
# DEV ONLY: true = return the code in the API response instead of sending SMS.
SMS_DEBUG_ECHO=false
