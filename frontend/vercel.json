{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next",
      "config": {
        "document": "frontend/vercel/document.md",
        "documentNavigation": "up"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "environment": {
    "VITE_API_URL": "@vercel/appDomain"
  }
}